# Match the numeric IDs returned by `id -u` and `id -g` on your host.
USER_UID=1000
USER_GID=1000

# Active simulation world: reactor_hall, furnace_annealing, conveyor_sorting,
# sensor_qualification.
SIM_WORLD=reactor_hall

# O3DE rendering backend: vulkan for GUI/GPU, null for headless CI.
O3DE_RHI=vulkan
O3DE_VERSION=26.05

# ONNX Runtime C++ release used by the images.
ORT_VERSION=1.20.1

# Compiler image base.
COMPILER_UBUNTU_VERSION=24.04

# DDS configuration.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Per-stack domains avoid cross-talk when several stacks run at once.
GAZEBO_JAZZY_DOMAIN=42
GAZEBO_LYRICAL_DOMAIN=43
O3DE_JAZZY_DOMAIN=44
O3DE_LYRICAL_DOMAIN=45
RUNTIME_JAZZY_DOMAIN=46
RUNTIME_LYRICAL_DOMAIN=47
ROS2_DEV_DOMAIN=48
ROS2_DEV_LYRICAL_DOMAIN=49
