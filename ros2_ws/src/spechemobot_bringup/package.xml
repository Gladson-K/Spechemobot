<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spechemobot_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and bridge configuration for the Spechemobot simulation.</description>
  <maintainer email="dev@example.com">Spechemobot</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>spechemobot_description</exec_depend>
  <exec_depend>spechemobot_process</exec_depend>
  <exec_depend>spechemobot_perception</exec_depend>
  <exec_depend>spechemobot_orchestration</exec_depend>
  <exec_depend>spechemobot_dataset</exec_depend>
  <exec_depend>spechemobot_eval</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
