<?xml version="1.0"?>
<sdf version="1.9">
  <world name="conveyor_sorting">
    <physics name="physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.8066</gravity>
    <scene>
      <ambient>0.42 0.44 0.46 1</ambient>
      <background>0.64 0.68 0.71 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-altimeter-system" name="gz::sim::systems::Altimeter"/>
    <plugin filename="gz-sim-logical-camera-system" name="gz::sim::systems::LogicalCamera"/>
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.30 0.30 0.30 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 -0.2 -0.9</direction>
    </light>

    <atmosphere type="adiabatic">
      <temperature>298</temperature>
      <temperature_gradient>0.001</temperature_gradient>
    </atmosphere>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>51.5074</latitude_deg>
      <longitude_deg>-0.1278</longitude_deg>
      <elevation>12</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <include>
      <uri>model://spechemobot_plant</uri>
      <name>plant</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://spechemobot_sensor_rig</uri>
      <name>sensor_rig</name>
      <pose>0 -6 3.5 0 -0.35 1.5708</pose>
    </include>

    <include>
      <uri>model://spechemobot_amr</uri>
      <name>amr_1</name>
      <pose>-7 4 0 0 0 1.5708</pose>
    </include>

    <include>
      <uri>model://spechemobot_arm</uri>
      <name>arm_1</name>
      <pose>0 6 0 0 0 3.14159</pose>
    </include>

    <model name="sorting_gate_a" static="true">
      <pose>-3.5 4 0.65 0 0 0</pose>
      <link name="gate">
        <collision name="gate_collision">
          <geometry>
            <box>
              <size>0.15 1.8 1.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="gate_visual">
          <geometry>
            <box>
              <size>0.15 1.8 1.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.65 0.05 1</ambient>
            <diffuse>0.95 0.72 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="sorting_gate_b" static="true">
      <pose>3.5 4 0.65 0 0 0</pose>
      <link name="gate">
        <collision name="gate_collision">
          <geometry>
            <box>
              <size>0.15 1.8 1.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="gate_visual">
          <geometry>
            <box>
              <size>0.15 1.8 1.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.65 0.05 1</ambient>
            <diffuse>0.95 0.72 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="hot_container" static="true">
      <pose>1.5 4 1.15 0 0 0</pose>
      <link name="container">
        <collision name="container_collision">
          <geometry>
            <cylinder>
              <radius>0.38</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="container_visual">
          <geometry>
            <cylinder>
              <radius>0.38</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.90 0.28 0.05 1</ambient>
            <diffuse>0.98 0.38 0.05 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>540</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <model name="cold_container" static="true">
      <pose>6.0 4 1.15 0 0 0</pose>
      <link name="container">
        <collision name="container_collision">
          <geometry>
            <cylinder>
              <radius>0.38</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="container_visual">
          <geometry>
            <cylinder>
              <radius>0.38</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.12 0.34 0.62 1</ambient>
            <diffuse>0.18 0.44 0.78 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>295</temperature>
          </plugin>
        </visual>
      </link>
    </model>
  </world>
</sdf>
