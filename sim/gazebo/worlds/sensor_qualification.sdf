<?xml version="1.0"?>
<sdf version="1.9">
  <world name="sensor_qualification">
    <physics name="physics" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.8066</gravity>
    <scene>
      <ambient>0.32 0.33 0.35 1</ambient>
      <background>0.52 0.55 0.58 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-altimeter-system" name="gz::sim::systems::Altimeter"/>
    <plugin filename="gz-sim-logical-camera-system" name="gz::sim::systems::LogicalCamera"/>
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"/>

    <light type="directional" name="calibration_light">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.95</constant>
        <linear>0.005</linear>
        <quadratic>0.0005</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
    </light>

    <atmosphere type="adiabatic">
      <temperature>300</temperature>
      <temperature_gradient>0.0005</temperature_gradient>
    </atmosphere>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>51.5074</latitude_deg>
      <longitude_deg>-0.1278</longitude_deg>
      <elevation>12</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <include>
      <uri>model://spechemobot_plant</uri>
      <name>plant</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://spechemobot_sensor_rig</uri>
      <name>sensor_rig</name>
      <pose>0 -7 3.0 0 -0.32 1.5708</pose>
    </include>

    <model name="target_320k" static="true">
      <pose>-3 -2 0.35 0 0 0</pose>
      <link name="target">
        <collision name="target_collision">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
        </collision>
        <visual name="target_visual">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.10 0.10 1</ambient>
            <diffuse>0.20 0.20 0.20 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>320</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <model name="target_420k" static="true">
      <pose>-1 -2 0.35 0 0 0</pose>
      <link name="target">
        <collision name="target_collision">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
        </collision>
        <visual name="target_visual">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.12 0.08 1</ambient>
            <diffuse>0.28 0.18 0.10 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>420</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <model name="target_520k" static="true">
      <pose>1 -2 0.35 0 0 0</pose>
      <link name="target">
        <collision name="target_collision">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
        </collision>
        <visual name="target_visual">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.10 0.04 1</ambient>
            <diffuse>0.38 0.15 0.05 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>520</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <model name="target_620k" static="true">
      <pose>3 -2 0.35 0 0 0</pose>
      <link name="target">
        <collision name="target_collision">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
        </collision>
        <visual name="target_visual">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.08 0.02 1</ambient>
            <diffuse>0.52 0.12 0.03 1</diffuse>
            <emissive>0.25 0.05 0.01 1</emissive>
          </material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>620</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <model name="fiducial_board" static="true">
      <pose>0 -2.8 0.9 0 0 0</pose>
      <link name="board">
        <visual name="board_visual">
          <geometry>
            <box>
              <size>8 0.05 0.9</size>
            </box>
          </geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
